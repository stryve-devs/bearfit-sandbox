# Server
PORT=3000

# Database
DATABASE_URL=topasteyourdatabaseurlhere

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =====================================================
# ENVIRONMENT SETUP (LOCAL DEVELOPMENT)
# =====================================================
# Each developer must create their own `.env` file.
# This file is NOT committed to GitHub.
#
# Steps:
# 1. Copy the example file:
#    cp .env.example .env
#
# 2. Fill in your own values below.
# =====================================================


# =====================================================
# DATABASE CONFIGURATION
# =====================================================
# Paste your own PostgreSQL database connection URL here.
# This can be from Prisma, Supabase, Neon, Railway, etc.
#
# Example format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#

# =====================================================
# REDIS CONFIGURATION
# =====================================================
# Redis is used for rate limiting and caching
# Local development: redis://localhost:6379
# Production: use your Redis provider URL (e.g., Redis Cloud, AWS ElastiCache)
#
REDIS_URL=redis://localhost:6379


# =====================================================
# JWT AUTHENTICATION SECRETS
# =====================================================
# These secrets are used to sign and verify JWT tokens.
# NEVER share these values.
# NEVER commit them to GitHub.
#
# Each developer should generate their own secrets.
#
# Recommended command (run in terminal):
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# Run the command TWICE:
# - Once for JWT_ACCESS_SECRET
# - Once for JWT_REFRESH_SECRET
#
JWT_ACCESS_SECRET=togeneraterandomstringhere
JWT_REFRESH_SECRET=togeneraterandomstringhere


# =====================================================
# JWT EXPIRY SETTINGS
# =====================================================
# Access token: short-lived (used for API requests)
# Refresh token: long-lived (used to get new access tokens)
#
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d


# =====================================================
# SERVER CONFIG
# =====================================================
PORT=3000
NODE_ENV=development

# Frontend URL for CORS (add your production URL when deploying)
FRONTEND_URL=http://localhost:8081

# =====================================================
# GOOGLE OAUTH
# =====================================================
# The Google OAuth Client ID used to verify ID tokens sent from the frontend.
# Create a credential in Google Cloud Console (OAuth 2.0 Client IDs) and paste
# the Client ID value below. This should match the client that requested the
# ID token on the frontend (web, mobile, etc.).
# Example: 1234567890-abcde.apps.googleusercontent.com
## Option A: Single client ID (keeps previous behavior)
GOOGLE_CLIENT_ID=your_google_client_id_here

## Option B: Multiple client IDs (recommended when you have platform-specific
## OAuth clients). Provide a comma-separated list. The server will accept ID
## tokens issued to any of these client IDs.
## Example including your Android client ID (already filled):
## Replace or append other platform client IDs (web, ios, macos, windows).
GOOGLE_CLIENT_IDS=863592591549-hsj8uumqlg9m02ce8lgor43po679oam5.apps.googleusercontent.com,863592591549-79r5fj14cduf6dr98310lesoi3gj8k19.apps.googleusercontent.com,your_ios_client_id

## (Optional) Named web client ID — useful for clarity and tooling.
GOOGLE_CLIENT_ID_WEB=863592591549-79r5fj14cduf6dr98310lesoi3gj8k19.apps.googleusercontent.com
