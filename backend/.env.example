# Server
PORT=3000

# Database
DATABASE_URL=toputdatabaseurlhere

REDIS_URL=redis://localhost:6379

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =====================================================
# ENVIRONMENT SETUP (LOCAL DEVELOPMENT)
# =====================================================
# Each developer must create their own `.env` file.
# This file is NOT committed to GitHub.
#
# Steps:
# 1. Copy the example file:
#    cp .env.example .env
#
# 2. Fill in your own values below.
# =====================================================


# =====================================================
# DATABASE CONFIGURATION
# =====================================================
# Paste your own PostgreSQL database connection URL here.
# This can be from Prisma, Supabase, Neon, Railway, etc.
#
# Example format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#

# =====================================================
# JWT AUTHENTICATION SECRETS
# =====================================================
# These secrets are used to sign and verify JWT tokens.
# NEVER share these values.
# NEVER commit them to GitHub.
#
# Each developer should generate their own secrets.
#
# Recommended command (run in terminal):
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# Run the command TWICE:
# - Once for JWT_ACCESS_SECRET
# - Once for JWT_REFRESH_SECRET
#
JWT_ACCESS_SECRET=superlonggeneratedaccesssecret
JWT_REFRESH_SECRET=superlonggeneratedrefreshsecret


# =====================================================
# JWT EXPIRY SETTINGS
# =====================================================
# Access token: short-lived (used for API requests)
# Refresh token: long-lived (used to get new access tokens)
#
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d


# GOOGLE OAUTH - multiple client IDs (comma-separated)
# Android client (provided)
GOOGLE_CLIENT_IDS=863592591549-hsj8uumqlg9m02ce8lgor43po679oam5.apps.googleusercontent.com,863592591549-79r5fj14cduf6dr98310lesoi3gj8k19.apps.googleusercontent.com

# Named web client ID (optional)
GOOGLE_CLIENT_ID_WEB=863592591549-79r5fj14cduf6dr98310lesoi3gj8k19.apps.googleusercontent.com

# Optional: other platform client IDs (fill as needed)
# GOOGLE_CLIENT_ID_IOS=
# GOOGLE_CLIENT_ID_MACOS=
# GOOGLE_CLIENT_ID_WINDOWS=
# Server

# =====================================================
# SERVER CONFIG
# =====================================================
PORT=3000
# Backend host reachable from client devices (set to your machine IP for real device testing)
# Example: BACKEND_HOST=http://192.168.0.130:3000
# Each developer should set this in their local .env file
BACKEND_HOST=writeyourbackendhosthere

# =====================================================
# EMAIL / SMTP CONFIGURATION (for OTP sending)
# Example (Gmail SMTP with an app password):
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=jeffamiduu@gmail.com
EMAIL_PASS=njfqaakqwwxdudfj
# This is an app password, not your regular email password. :)
EMAIL_FROM=jeffamiduu@gmail.com
# =====================================================

