# Frontend .gitignore

# Flutter / Dart
.dart_tool/
/.packages
/.flutter-plugins
/.flutter-plugins-dependencies
build/

# Flutter generated or cached
/.flutter-plugins
/.flutter-plugins-dependencies

# Node / Expo
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts

# IDEs
.idea/
.vscode/

# Debug/log
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Local env/secrets
.env*.local

# TypeScript cache
*.tsbuildinfo

# Misc
*.orig.*
app-example

# -----------------------------
# Android: track project files, ignore build outputs and secrets
# -----------------------------
# Keep the android project files (namespace/applicationId, Gradle settings, wrappers, manifest, kotlin sources, res)
!/android/build.gradle.kts
!/android/settings.gradle.kts
!/android/gradle/wrapper/gradle-wrapper.properties
!/android/gradle/wrapper/gradle-wrapper.jar
!/android/app/src/main/AndroidManifest.xml
!/android/app/src/main/kotlin/**
!/android/app/src/main/res/**
!/android/gradle.properties

# Ignore Android build output and caches
android/build/
android/.gradle/
android/app/build/
android/.cxx/

# Ignore machine-specific or sensitive files
android/local.properties
android/key.properties
android/**/*.keystore
android/**/*.jks

# -----------------------------
# iOS: keep app sources, ignore pods/build
# -----------------------------
!/ios/Runner/**
ios/Pods/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec

# -----------------------------
# Keystores and signing files (sensitive)
# -----------------------------
*.jks
*.keystore

